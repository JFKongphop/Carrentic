{
  "name": "@openledger-cfo/uniswap",
  "description": "Uniswap Trading API pricing oracle + fund NAV computation",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openledger-cfo/eslint-config": "workspace:*",
    "@openledger-cfo/prettier-config": "workspace:*",
    "@openledger-cfo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv": "^16.4.5",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@openledger-cfo/prettier-config"
}
