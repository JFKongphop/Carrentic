# Optional: absolute path to the demo ledger config (defaults to <repo>/.oled/config.json)
# OLED_CONFIG="/abs/path/to/.oled/config.json"

# ─────────────────────────────────────────────────────────────────────────────
# Assetic — copy this file to `.env` and fill in real values.
# `.env` is gitignored; NEVER commit real keys. Do not paste secrets in chat.
# ─────────────────────────────────────────────────────────────────────────────

# Control-plane database — Railway Postgres (drizzle pg driver).
# Use the PUBLIC connection url (*.proxy.rlwy.net), not the internal railway host,
# because the app is deployed on Fly.io, not Railway.
DATABASE_URL=""                             # 🔴 SECRET

# The graph
GRAPH_API_KEY=""                            # 🔴 SECRET

# Hedera testnet (portal.hedera.com → create testnet account, fund via faucet)
HEDERA_NETWORK="testnet"
HEDERA_OPERATOR_ID="0.0.xxxxxxx"          # public — your account id
HEDERA_OPERATOR_EVM="0x..."                # public — the account's EVM address
HEDERA_OPERATOR_KEY=""                      # 🔴 SECRET — private key (DER or raw; the spike pins the format)

# Uniswap Developer Platform (developers.uniswap.org) — NAV / pricing oracle
UNISWAP_API_KEY=""                          # 🔴 SECRET
# UNISWAP_API_BASE="https://..."           # set once we confirm the endpoint in the spike

# OpenAI — the agent's LLM engine (not a prize; cheap infra)
OPENAI_API_KEY=""                           # 🔴 SECRET
# OPENAI_MODEL="gpt-4o-mini"               # override the default model if desired
